<!--
  Cánh tay robot 5 bậc tự do + kẹp 2 ngón, dùng cho bài "Gắp và đặt vật".

  Cây khớp (kinematic tree):
    de (đế, cố định)
    └─ than        [xoay_de : hinge quanh z]   quay cả cánh tay quanh trục đứng
       └─ tay_tren [vai     : hinge quanh y]   nghiêng cánh tay trên
          └─ tay_duoi [khuyu : hinge quanh y]  gập khuỷu
             └─ co_tay  [co_tay  : hinge quanh y]  gập cổ tay
                └─ ban_tay [xoay_tay : hinge quanh z]  xoay bàn tay
                   ├─ ngon_trai [slide theo +y]
                   └─ ngon_phai [slide theo -y]

  Ở cấu hình q = 0 cánh tay dựng thẳng đứng.
  Site "tcp" (Tool Center Point) là tâm vùng kẹp giữa 2 ngón: IK sẽ điều khiển điểm này.
-->
<mujoco model="canh_tay_gap_do">
  <compiler angle="radian" autolimits="true"/>

  <!-- cone elliptic + impratio cao giúp ma sát kẹp ổn định, vật không bị trượt khỏi ngón -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture name="luoi" type="2d" builtin="checker" rgb1=".85 .85 .85" rgb2=".7 .7 .7"
             width="300" height="300"/>
    <material name="luoi" texture="luoi" texrepeat="8 8"/>
    <material name="kim_loai" rgba=".55 .6 .7 1"/>
    <material name="cam" rgba="1 .55 .1 1"/>
    <material name="ngon" rgba=".2 .2 .2 1"/>
  </asset>

  <default>
    <joint damping="2" armature="0.05"/>
    <!-- Mặc định thân cánh tay KHÔNG va chạm (chỉ để nhìn) -> tránh tự va chạm phức tạp.
         Chỉ ngón kẹp, vật và sàn mới có va chạm. -->
    <geom contype="0" conaffinity="0" material="kim_loai"/>
    <default class="va_cham">
      <!-- solref="0.004 1": tiếp xúc cứng hơn mặc định (0.02). Ma sát trong MuJoCo là ràng buộc
           MỀM: vật vẫn "trượt" chậm với vận tốc tỉ lệ lực cần giữ. Mặc định quá mềm -> vật trôi
           ~9 mm trong kẹp khi tay chạy nhanh. timeconst nên >= 2*timestep để ổn định. -->
      <geom contype="1" conaffinity="1" friction="1.5 0.01 0.001" condim="4" solref="0.004 1"/>
    </default>
    <position kp="500" forcerange="-80 80"/>
  </default>

  <worldbody>
    <light pos="0 -1 2" dir="0 0.5 -1" diffuse=".8 .8 .8"/>
    <light pos="1 1 2" dir="-0.5 -0.5 -1" diffuse=".4 .4 .4"/>
    <geom name="san" type="plane" size="1 1 0.05" material="luoi" class="va_cham"/>

    <!-- Vị trí đích để đặt vật (chỉ hiển thị, không va chạm) -->
    <site name="dich" pos="0.05 0.42 0.001" size="0.035 0.001" type="cylinder" rgba="0 .8 0 .5"/>

    <body name="de">
      <geom type="cylinder" size="0.09 0.05" pos="0 0 0.05"/>

      <body name="than" pos="0 0 0.1" gravcomp="1">
        <joint name="xoay_de" axis="0 0 1" range="-3.1 3.1"/>
        <geom type="cylinder" size="0.06 0.05" pos="0 0 0.05"/>

        <body name="tay_tren" pos="0 0 0.1" gravcomp="1">
          <joint name="vai" axis="0 1 0" range="-2 2"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.3" size="0.035"/>

          <body name="tay_duoi" pos="0 0 0.3" gravcomp="1">
            <joint name="khuyu" axis="0 1 0" range="-2.7 2.7"/>
            <geom type="capsule" fromto="0 0 0  0 0 0.3" size="0.03"/>

            <body name="co_tay" pos="0 0 0.3" gravcomp="1">
              <joint name="co_tay" axis="0 1 0" range="-2.2 2.2"/>
              <geom type="sphere" size="0.035"/>

              <body name="ban_tay" pos="0 0 0.04" gravcomp="1">
                <joint name="xoay_tay" axis="0 0 1" range="-3.1 3.1"/>
                <geom type="box" size="0.03 0.065 0.012" pos="0 0 0.02"/>
                <site name="tcp" pos="0 0 0.14" size="0.008" rgba="1 0 0 1"/>

                <body name="ngon_trai" pos="0 0 0.03" gravcomp="1">
                  <joint name="ngon_trai" type="slide" axis="0 1 0" range="0 0.05" damping="5"/>
                  <geom type="box" size="0.012 0.008 0.05" pos="0 0.008 0.08"
                        class="va_cham" material="ngon" mass="0.05"/>
                </body>
                <body name="ngon_phai" pos="0 0 0.03" gravcomp="1">
                  <joint name="ngon_phai" type="slide" axis="0 -1 0" range="0 0.05" damping="5"/>
                  <geom type="box" size="0.012 0.008 0.05" pos="0 -0.008 0.08"
                        class="va_cham" material="ngon" mass="0.05"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Vật cần gắp: khối lập phương cạnh 4 cm, có freejoint (6 bậc tự do), bị xoay 30 độ -->
    <body name="vat" pos="0.42 -0.1 0.02" euler="0 0 0.5236">
      <freejoint name="vat"/>
      <geom name="vat" type="box" size="0.02 0.02 0.02" mass="0.1" class="va_cham" material="cam"/>
    </body>
  </worldbody>

  <!-- Bộ truyền động: servo vị trí cho từng khớp. ctrl = góc (rad) hoặc độ mở ngón (m) mong muốn -->
  <actuator>
    <position name="xoay_de"  joint="xoay_de"  ctrlrange="-3.1 3.1"/>
    <position name="vai"      joint="vai"      ctrlrange="-2 2"/>
    <position name="khuyu"    joint="khuyu"    ctrlrange="-2.7 2.7"/>
    <position name="co_tay"   joint="co_tay"   ctrlrange="-2.2 2.2"/>
    <position name="xoay_tay" joint="xoay_tay" ctrlrange="-3.1 3.1" kp="200"/>
    <!-- Kẹp: MỘT actuator kéo ngón trái; ngón phải bị ràng buộc (equality) luôn bằng ngón trái.
         kp cao để khi kẹp vật (lệnh 0, ngón bị chặn ở 2 cm) lực bão hoà ở 30 N.
         Lực bị giới hạn -> kẹp "mềm", không làm mô phỏng nổ. -->
    <position name="kep" joint="ngon_trai" ctrlrange="0 0.05" kp="1000" forcerange="-30 30"/>
  </actuator>

  <!-- Liên động 2 ngón: q_phai = q_trai (giống cơ cấu bánh răng/thanh truyền của kẹp thật).
       Nếu 2 ngón độc lập, khi cả hai cùng bão hoà lực thì cụm "ngón + vật" trôi tự do
       theo phương kẹp mỗi khi cánh tay tăng tốc -> vật bị lệch khỏi tâm kẹp. -->
  <equality>
    <joint joint1="ngon_phai" joint2="ngon_trai" polycoef="0 1 0 0 0" solref="0.004 1"/>
  </equality>

  <!-- Tư thế ban đầu: hơi gập để tránh điểm kỳ dị (cánh tay thẳng tuyệt đối) -->
  <keyframe>
    <key name="san_sang"
         qpos="0 0.3 1.0 1.84 0 0.04 0.04  0.42 -0.1 0.02  0.9659 0 0 0.2588"
         ctrl="0 0.3 1.0 1.84 0 0.04"/>
  </keyframe>
</mujoco>
